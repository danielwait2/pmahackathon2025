generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  password      String
  avatarUrl     String?   @map("avatar_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  createdProjects   Project[]         @relation("ProjectCreator")
  projectMembers    ProjectMember[]
  availability      Availability[]
  assignedTasks     Task[]
  createdMeetings   Meeting[]

  @@map("users")
}

model Project {
  id           String    @id @default(uuid())
  name         String
  description  String?
  deadline     DateTime?
  classId      String?   @map("class_id")
  isAssignment Boolean   @default(false) @map("is_assignment")
  createdById  String    @map("created_by")
  inviteCode   String    @unique @map("invite_code")
  shareToken   String?   @unique @map("share_token")
  createdAt    DateTime  @default(now()) @map("created_at")

  createdBy       User                @relation("ProjectCreator", fields: [createdById], references: [id])
  class           Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  members         ProjectMember[]
  availability    Availability[]
  tasks           Task[]
  teamAgreement   TeamAgreement?
  meetings        Meeting[]

  @@map("projects")
}

model ProjectMember {
  id                 String         @id @default(uuid())
  projectId          String         @map("project_id")
  userId             String?        @map("user_id")
  guestName          String?        @map("guest_name")
  role               String         @default("member")
  joinedAt           DateTime       @default(now()) @map("joined_at")

  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestAvailability  Availability[]

  @@unique([projectId, userId])
  @@map("project_members")
}

model Availability {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  userId           String?   @map("user_id")
  guestMemberId    String?   @map("guest_member_id")
  slots            String    @default("[]")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestMember      ProjectMember?  @relation(fields: [guestMemberId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@unique([projectId, guestMemberId])
  @@map("availability")
}

model Task {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String
  description String?
  assignedTo  String?   @map("assigned_to")
  status      String    @default("todo")
  dueDate     DateTime? @map("due_date")
  reminderDate DateTime? @map("reminder_date")
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?     @relation(fields: [assignedTo], references: [id])

  @@map("tasks")
}

model TeamAgreement {
  id                   String    @id @default(uuid())
  projectId            String    @unique @map("project_id")
  responseTimeHours    Int       @default(24) @map("response_time_hours")
  meetingFrequency     String?   @map("meeting_frequency")
  communicationChannel String?   @map("communication_channel")
  qualityStandards     String?   @map("quality_standards")
  agreedBy             String    @default("[]") @map("agreed_by")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("team_agreements")
}

model Meeting {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  title       String
  date        String   // YYYY-MM-DD
  startTime   String   // HH:mm
  endTime     String   // HH:mm
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("meetings")
}

model Class {
  id        String    @id @default(uuid())
  name      String    @unique @map("name")
  createdAt DateTime  @default(now()) @map("created_at")

  projects  Project[]

  @@map("classes")
}
